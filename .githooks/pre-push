#!/usr/bin/env bash
#
# pre-push — the local half of CI (.github/workflows/ci.yml, quality-checks),
# so a push CI would reject is caught on this machine first. Installed by the
# `prepare` script (.githooks/install.cjs), which points core.hooksPath here.
#
# Steps, in order, stopping at the first failure:
#   1. lockfile        package.json and package-lock.json agree (`npm ci` would accept them)
#   2. contract types  npm run build-tc
#   3. lint + types    npm run build         (eslint . && tsc --build)
#   4. unit tests      npm run test:unit
#   5. bundle          npm run rollup-build
#
# It checks the working tree, not the pushed commits — commit first.
# Skip it deliberately with SKIP_PREPUSH=1 git push … — CI is still the gate.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

red() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; }
yellow() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }

if [ "${SKIP_PREPUSH:-}" = "1" ]; then
  yellow "pre-push: SKIPPED (SKIP_PREPUSH=1). Nothing was checked locally."
  yellow "pre-push: CI is still the gate. Expect it to fail if this push is broken."
  exit 0
fi

step() {
  local name="$1"
  shift
  printf '\033[1m▸ pre-push: %s\033[0m\n' "$name" >&2
  if ! "$@"; then
    red "✗ pre-push: '$name' failed, so the push was stopped."
    red "  Fix it, or skip deliberately with SKIP_PREPUSH=1 (CI still checks)."
    exit 1
  fi
}

lockfile() {
  local out
  if ! out="$(npm ci --dry-run --ignore-scripts --no-audit --no-fund 2>&1)"; then
    # The reason, without npm's usage text that follows it.
    printf '%s\n' "$out" | sed -n '/^npm error Clean install/q;/^npm error ./p' >&2
    return 1
  fi
}

step "lockfile in sync" lockfile
step "contract types" npm run --silent build-tc
step "lint + type-check" npm run --silent build
step "unit tests" npm run --silent test:unit -- --ci --silent
step "bundle" npm run --silent rollup-build

printf '\033[1;32m✓ pre-push: lockfile, contract types, lint, type-check, unit tests and bundle all pass\033[0m\n' >&2
